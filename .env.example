APP_NAME=nokia
VERSION=0.1.0
DEBUG=false

# PostgreSQL — port 5434 because tentoro occupies 5432/5433
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=nokia_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nokia

ECHO_SQL=false

# Outbound HTTP to Open-Meteo
HTTP_CACHE_ENABLED=true
HTTP_CACHE_TTL_SECONDS=900
HTTP_RETRIES=3
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
